node_modules/
.pnpm-store/
.nx/
.nx-cache/
coverage/
**/dist/

# Playwright run artifacts, regenerated by every e2e run.
test-results/
playwright-report/
*.tgz
release-artifacts/
.env
.env.*
!.env.example
.DS_Store
.pi/
*.log
.codex-local/
logs/
tmp/
.claude/settings.local.json
/-.wav

# Runner native payloads. Fetched from upstream releases by
# scripts/fetch-runner-binaries.mjs and verified against pinned checksums,
# rather than stored here. See CONTRIBUTING.md.
packages/default/doompi-runner-rmux-*/vendor/
packages/default/doompi-runner-rtk-*/vendor/
# The cockpit dev loop's generated plugin registry (packages/clients/doompi-web/vite.config.ts).
packages/clients/doompi-web/.dev/
# The desktop app's staged cockpit payload and packaged artifacts, produced by
# `pnpm deploy` and electron-builder rather than stored here.
packages/clients/doompi-desktop/build/
packages/clients/doompi-desktop/release/
