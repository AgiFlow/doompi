import type { MessageLine } from '@agimon-ai/doompi-web-components';
import { type ToolResultView, toolResultTextLines } from '@agimon-ai/doompi-web-contracts';

/** The name this package registers the tool under (registerTool's `name`); web-plugin-tool-renderers checks it. */
export const {{ toolName | camelCase }}ToolName = '{{ toolName }}' as const;

/** Lines the collapsed item shows before it expands. */
export const {{ toolName | camelCase }}CollapsedLines = 8;

/** The header summary: the call's most telling argument, replace with the real one. */
export function {{ toolName | camelCase }}CallSummary(args: Readonly<Record<string, unknown>>): string {
  const target = args.path ?? args.name ?? args.query;
  return typeof target === 'string' ? target : '';
}

/**
 * The body as toned lines: what the result's details say, or its text. Pure,
 * so a unit test can pin it without a DOM; the item decides how many to show.
 */
export function {{ toolName | camelCase }}ResultLines(result: ToolResultView | null): MessageLine[] {
  if (result === null) return [];
  return toolResultTextLines(result.content).map((text) => ({ text, tone: 'dim' }));
}
