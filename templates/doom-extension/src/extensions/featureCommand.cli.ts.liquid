import { defineCliCommand } from '@agimon-ai/doompi-core/extension-file';
import { defineCommand } from '@agimon-ai/doompi-core/pi-extension';

import {
  {{ commandName | snakeCase | upper }}_COMMAND_DESCRIPTION,
  {{ commandName | snakeCase | upper }}_COMMAND_NAME,
} from '../../../../../constants/{{ commandName | camelCase }}';

/**
 * `/{{ commandName }}` in the terminal: {{ commandDescription }}.
 *
 * Pi takes the command as a native declaration, so the generated entry leaves
 * it alone and this half carries its own name.
 */
export default defineCliCommand(
  defineCommand({
    name: {{ commandName | snakeCase | upper }}_COMMAND_NAME,
    description: {{ commandName | snakeCase | upper }}_COMMAND_DESCRIPTION,
    async execute(_args, execution) {
      await execution.notify({ body: '{{ commandDescription }}', level: 'info' });
    },
  }),
);
