import type { ExtensionAPI } from '@earendil-works/pi-coding-agent';
import type { {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionService } from '../types/extension.ts';

export const COMMAND_NAME = '{{ commandName | kebabCase }}';
export const COMMAND_DESCRIPTION = '{{ commandDescription }}';

export function register{{ packageName | replace: "doompi-", "" | pascalCase }}Command(
  pi: Pick<ExtensionAPI, 'registerCommand'>,
  service: {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionService,
): void {
  pi.registerCommand(COMMAND_NAME, {
    description: COMMAND_DESCRIPTION,
    handler: async (_args, ctx) => {
      const result = await service.execute();
      if (ctx.hasUI) ctx.ui.notify(result.message, result.level);
    },
  });
}
