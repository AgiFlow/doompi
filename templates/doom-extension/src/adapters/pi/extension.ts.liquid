import { connectDoomCordisHost } from '@agimon-ai/doompi-extension-contracts/cordis-host';
import { DOOM_HELP_SERVICE, requireDoomHelpService } from '@agimon-ai/doompi-extension-contracts/help';
import type { Context } from '@deepseek-ai/cordis';
import type { ExtensionAPI } from '@earendil-works/pi-coding-agent';
import { register{{ packageName | replace: "doompi-", "" | pascalCase }}Command } from '../../commands/{{ commandName | camelCase }}Command.ts';
import { create{{ packageName | replace: "doompi-", "" | pascalCase }}Container } from '../../container';
import type { {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionDependencies } from '../../types/extension';

const PACKAGE_SOURCE = '@agimon-ai/{{ packageName | kebabCase }}';

/**
 * Installs the package runtime inside its host-owned Cordis plugin fiber.
 *
 * Everything registered inside the effect is owned by the cordis fiber, so one
 * dispose on session shutdown unwinds it in reverse order. Yield a disposer for
 * each registration rather than tracking cleanup by hand; Pi can reload an
 * extension in-process, and a leaked listener duplicates work against stale
 * session state.
 */
export function install{{ packageName | replace: "doompi-", "" | pascalCase }}Runtime(
  cordis: Context,
  pi: ExtensionAPI,
  dependencies: {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionDependencies = create{{ packageName | replace: "doompi-", "" | pascalCase }}Container(),
): void {
  cordis.inject([DOOM_HELP_SERVICE], (helpContext) => {
    const contribution = requireDoomHelpService(helpContext).register({
      source: PACKAGE_SOURCE,
      moduleUrl: import.meta.url,
      skills: [
        {
          name: 'doompi-use-{{ packageName | replace: "doompi-", "" | kebabCase }}',
          description: 'Use @agimon-ai/{{ packageName | kebabCase }}: {{ packageDescription }}',
        },
      ],
    });
    return () => contribution.dispose();
  });

  register{{ packageName | replace: "doompi-", "" | pascalCase }}Command(pi, dependencies.service);
}

interface {{ packageName | replace: "doompi-", "" | pascalCase }}PluginConfig {
  readonly pi: ExtensionAPI;
  readonly dependencies: {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionDependencies;
}

function {{ packageName | replace: "doompi-", "" | camelCase }}Plugin(
  cordis: Context,
  config: {{ packageName | replace: "doompi-", "" | pascalCase }}PluginConfig,
): void {
  install{{ packageName | replace: "doompi-", "" | pascalCase }}Runtime(cordis, config.pi, config.dependencies);
}

/** Connects the package's standard Pi entry to DoomPi's shared Cordis host. */
export async function activate{{ packageName | replace: "doompi-", "" | pascalCase }}Extension(
  pi: ExtensionAPI,
  dependencies: {{ packageName | replace: "doompi-", "" | pascalCase }}ExtensionDependencies = create{{ packageName | replace: "doompi-", "" | pascalCase }}Container(),
): Promise<void> {
  const connection = await connectDoomCordisHost(pi, PACKAGE_SOURCE);
  const fiber = connection.root.plugin({{ packageName | replace: "doompi-", "" | camelCase }}Plugin, { pi, dependencies });

  try {
    await fiber;
  } catch (error) {
    try {
      await fiber.dispose();
    } finally {
      await connection.dispose();
    }
    throw error;
  }

  let disposal: Promise<void> | undefined;
  pi.on(
    'session_shutdown',
    () =>
      (disposal ??= (async () => {
        try {
          await fiber.dispose();
        } finally {
          await connection.dispose();
        }
      })()),
  );
}

export default activate{{ packageName | replace: "doompi-", "" | pascalCase }}Extension;
