{
  "name": "@agimon-ai/{{ packageName }}",
  "version": "0.0.0",
  "description": "{{ packageDescription }}",
  "keywords": [
    "components",
    "design-system",
    "doompi",
    "react",
    "shadcn",
    "tailwind",
    "theme",
    "{{ packageKeyword }}"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "{{ author }}",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/core/{{ packageName }}"
  },
  "files": [
    "dist",
    "styles",
    "themes",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.mts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.cjs"
    },
    "./styles.css": "./styles/tokens.css",
    "./themes/*.json": "./themes/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agimon-ai/vibe-lint-plugin-doom-web": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
