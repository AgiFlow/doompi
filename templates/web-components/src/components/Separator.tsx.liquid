import type { ComponentProps } from 'react';
import { cn } from '../lib/cn.ts';

/** A hairline in the soft border colour; vertical when asked. */
export function Separator({ className, vertical = false, ...props }: ComponentProps<'div'> & { vertical?: boolean }) {
  return (
    <div
      data-slot="separator"
      role="separator"
      aria-orientation={vertical ? 'vertical' : 'horizontal'}
      className={cn('shrink-0 bg-doom-border-soft', vertical ? 'h-full w-px' : 'h-px w-full', className)}
      {...props}
    />
  );
}
