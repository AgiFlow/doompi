# The client and server layer graphs, the feature isolation rule, and the
# naming conventions come from the doom-web plugin preset. Declare only what is
# specific to this package.
plugins:
  - core
  - doom-web

extends:
  - core/recommended
  - doom-web/recommended

ignore:
  - "dist/**"
  - "coverage/**"
  - "playwright-report/**"
  - "test-results/**"

# The web plugin scanner and its generators run at build-config load time,
# outside both layer graphs; they may only read package manifests and write
# the generated registry modules.
boundaries:
  - name: web-plugin-scripts
    pattern: scripts/webPlugins/**
    allowedImports:
      - scripts/webPlugins/**
  # The installable PWA and its service worker form a separate browser program.
  - name: pwa
    pattern: src/pwa/**
    allowedImports:
      - src/pwa/**
      - src/types
      - src/types/**

overrides:
  # Story files are read by the style-system renderer, which resolves the
  # default export by looking for a bare `const meta`. Naming the export at the
  # point of definition breaks the render, so the export-shape rules are off
  # here. Every other rule, theming included, still applies to stories.
  - files:
      - src/web/components/*.stories.tsx
    rules:
      no-default-export: off
      direct-export-only: off
