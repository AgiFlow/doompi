{
  "name": "@agimon-ai/{{ packageName }}",
  "version": "0.0.0",
  "description": "{{ packageDescription }}",
  "keywords": [
    "cockpit",
    "coding-agent",
    "doompi",
    "pi-coding-agent",
    "{{ packageKeyword }}",
    "web"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "{{ author }}",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/clients/{{ packageName }}"
  },
  "bin": {
    "{{ packageName }}": "./dist/bin/serve.mjs"
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "README.md",
    "docs",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./bundler": {
      "types": "./dist/bundler.d.mts",
      "import": "./dist/bundler.mjs",
      "require": "./dist/bundler.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && vite build --config vite.pwa.config.ts && vite build --config vite.pwa.config.ts --mode worker",
    "dev": "vite",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.11",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-client": "0.85.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@vitejs/plugin-react": "6.1.1",
    "@zxing/browser": "^0.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/vibe-lint-plugin-doom-web": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
