import type { ReactNode } from 'react';

export type Tone = 'neutral' | 'blue' | 'green' | 'yellow' | 'red' | 'magenta' | 'violet' | 'cyan';

const TONE_CLASS: Readonly<Record<Tone, string>> = {
  neutral: 'border-doom-border text-doom-dim',
  blue: 'border-doom-blue/40 text-doom-blue',
  green: 'border-doom-green/40 text-doom-green',
  yellow: 'border-doom-yellow/40 text-doom-yellow',
  red: 'border-doom-red/40 text-doom-red',
  magenta: 'border-doom-magenta/40 text-doom-magenta',
  violet: 'border-doom-violet/40 text-doom-violet',
  cyan: 'border-doom-cyan/40 text-doom-cyan',
};

export function Chip({ tone = 'neutral', children, testId }: { tone?: Tone; children: ReactNode; testId?: string }) {
  return (
    <span
      data-testid={testId}
      className={`inline-flex items-center gap-1.5 rounded border px-2 py-0.5 text-[10px] ${TONE_CLASS[tone]}`}
    >
      {children}
    </span>
  );
}

export function Dot({ tone = 'neutral' }: { tone?: Tone }) {
  const fill: Record<Tone, string> = {
    neutral: 'bg-doom-faint',
    blue: 'bg-doom-blue',
    green: 'bg-doom-green',
    yellow: 'bg-doom-yellow',
    red: 'bg-doom-red',
    magenta: 'bg-doom-magenta',
    violet: 'bg-doom-violet',
    cyan: 'bg-doom-cyan',
  };
  return <span className={`inline-block h-1.5 w-1.5 shrink-0 rounded-full ${fill[tone]}`} />;
}
