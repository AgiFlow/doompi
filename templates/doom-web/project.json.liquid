{
  "name": "@agimon-ai/{{ packageName }}",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/clients/{{ packageName }}/src",
  "projectType": "application",
  "tags": ["stage:active"],
  "sourceTemplate": "doom-web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/clients/doompi-web",
        "forwardAllArgs": false
      }
    }
  }
}
