{
  "name": "@agimon-ai/doompi-task",
  "version": "0.0.1-alpha.88",
  "description": "Persistent, dependency-aware task graphs and subagent delegation for Pi coding sessions.",
  "keywords": [
    "ai",
    "coding-agent",
    "delegation",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-package",
    "subagents",
    "task-graph",
    "task-management"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "layers/task/doompi-task"
  },
  "files": [
    "dist",
    "src/types/webTasks.ts",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./commands": {
      "types": "./dist/commands.d.mts",
      "import": "./dist/commands.mjs",
      "require": "./dist/commands.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./delegationManager": {
      "types": "./dist/delegationManager.d.mts",
      "import": "./dist/delegationManager.mjs",
      "require": "./dist/delegationManager.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./logSinkTelemetry": {
      "types": "./dist/logSinkTelemetry.d.mts",
      "import": "./dist/logSinkTelemetry.mjs",
      "require": "./dist/logSinkTelemetry.cjs"
    },
    "./storeInvariants": {
      "types": "./dist/storeInvariants.d.mts",
      "import": "./dist/storeInvariants.mjs",
      "require": "./dist/storeInvariants.cjs"
    },
    "./storePaths": {
      "types": "./dist/storePaths.d.mts",
      "import": "./dist/storePaths.mjs",
      "require": "./dist/storePaths.cjs"
    },
    "./storeProcessLiveness": {
      "types": "./dist/storeProcessLiveness.d.mts",
      "import": "./dist/storeProcessLiveness.mjs",
      "require": "./dist/storeProcessLiveness.cjs"
    },
    "./storeReconcile": {
      "types": "./dist/storeReconcile.d.mts",
      "import": "./dist/storeReconcile.mjs",
      "require": "./dist/storeReconcile.cjs"
    },
    "./storeReducer": {
      "types": "./dist/storeReducer.d.mts",
      "import": "./dist/storeReducer.mjs",
      "require": "./dist/storeReducer.cjs"
    },
    "./storeTaskGraph": {
      "types": "./dist/storeTaskGraph.d.mts",
      "import": "./dist/storeTaskGraph.mjs",
      "require": "./dist/storeTaskGraph.cjs"
    },
    "./storeTaskStore": {
      "types": "./dist/storeTaskStore.d.mts",
      "import": "./dist/storeTaskStore.mjs",
      "require": "./dist/storeTaskStore.cjs"
    },
    "./storeTypes": {
      "types": "./dist/storeTypes.d.mts",
      "import": "./dist/storeTypes.mjs",
      "require": "./dist/storeTypes.cjs"
    },
    "./toolPromptGuidelines": {
      "types": "./dist/toolPromptGuidelines.d.mts",
      "import": "./dist/toolPromptGuidelines.mjs",
      "require": "./dist/toolPromptGuidelines.cjs"
    },
    "./toolResponseEnvelope": {
      "types": "./dist/toolResponseEnvelope.d.mts",
      "import": "./dist/toolResponseEnvelope.mjs",
      "require": "./dist/toolResponseEnvelope.cjs"
    },
    "./toolSchema": {
      "types": "./dist/toolSchema.d.mts",
      "import": "./dist/toolSchema.mjs",
      "require": "./dist/toolSchema.cjs"
    },
    "./toolTaskTool": {
      "types": "./dist/toolTaskTool.d.mts",
      "import": "./dist/toolTaskTool.mjs",
      "require": "./dist/toolTaskTool.cjs"
    },
    "./tuiFormat": {
      "types": "./dist/tuiFormat.d.mts",
      "import": "./dist/tuiFormat.mjs",
      "require": "./dist/tuiFormat.cjs"
    },
    "./tuiSelectors": {
      "types": "./dist/tuiSelectors.d.mts",
      "import": "./dist/tuiSelectors.mjs",
      "require": "./dist/tuiSelectors.cjs"
    },
    "./tuiTaskOverlay": {
      "types": "./dist/tuiTaskOverlay.d.mts",
      "import": "./dist/tuiTaskOverlay.mjs",
      "require": "./dist/tuiTaskOverlay.cjs"
    },
    "./tuiTaskSpace": {
      "types": "./dist/tuiTaskSpace.d.mts",
      "import": "./dist/tuiTaskSpace.mjs",
      "require": "./dist/tuiTaskSpace.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.mcp.config.ts",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mcp.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ],
    "ui": {
      "entry": "./generated/mcp-ui.ts",
      "dist": "./dist/extensions/mcp-ui.mjs",
      "widgets": [
        "@agimon-ai/doompi-task/task"
      ]
    }
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "task",
    "channels": [
      "task_graph"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
