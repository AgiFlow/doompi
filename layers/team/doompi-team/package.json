{
  "name": "@agimon-ai/doompi-team",
  "version": "0.0.1-alpha.80",
  "description": "Asynchronous named subagents, team runs, intercom, and model policy for Pi coding agents.",
  "keywords": [
    "agent-team",
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "inter-agent-communication",
    "multi-agent",
    "pi-coding-agent",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "layers/team/doompi-team"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./apiContracts": {
      "types": "./dist/apiContracts.d.mts",
      "import": "./dist/apiContracts.mjs",
      "require": "./dist/apiContracts.cjs"
    },
    "./capabilityCeiling": {
      "types": "./dist/capabilityCeiling.d.mts",
      "import": "./dist/capabilityCeiling.mjs",
      "require": "./dist/capabilityCeiling.cjs"
    },
    "./delegation": {
      "types": "./dist/delegation.d.mts",
      "import": "./dist/delegation.mjs",
      "require": "./dist/delegation.cjs"
    },
    "./delegationApi": {
      "types": "./dist/delegationApi.d.mts",
      "import": "./dist/delegationApi.mjs",
      "require": "./dist/delegationApi.cjs"
    },
    "./env": {
      "types": "./dist/env.d.mts",
      "import": "./dist/env.mjs",
      "require": "./dist/env.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./fablePlan": {
      "types": "./dist/fablePlan.d.mts",
      "import": "./dist/fablePlan.mjs",
      "require": "./dist/fablePlan.cjs"
    },
    "./fablePlanApi": {
      "types": "./dist/fablePlanApi.d.mts",
      "import": "./dist/fablePlanApi.mjs",
      "require": "./dist/fablePlanApi.cjs"
    },
    "./runs/background/cliRunnerEntry": {
      "types": "./dist/runs/background/cliRunnerEntry.d.mts",
      "import": "./dist/runs/background/cliRunnerEntry.mjs",
      "require": "./dist/runs/background/cliRunnerEntry.cjs"
    },
    "./runtimeSubagentPolicy": {
      "types": "./dist/runtimeSubagentPolicy.d.mts",
      "import": "./dist/runtimeSubagentPolicy.mjs",
      "require": "./dist/runtimeSubagentPolicy.cjs"
    },
    "./runtimeSubagentTool": {
      "types": "./dist/runtimeSubagentTool.d.mts",
      "import": "./dist/runtimeSubagentTool.mjs",
      "require": "./dist/runtimeSubagentTool.cjs"
    },
    "./subagentPolicy": {
      "types": "./dist/subagentPolicy.d.mts",
      "import": "./dist/subagentPolicy.mjs",
      "require": "./dist/subagentPolicy.cjs"
    },
    "./subagentTool": {
      "types": "./dist/subagentTool.d.mts",
      "import": "./dist/subagentTool.mjs",
      "require": "./dist/subagentTool.cjs"
    },
    "./teamSnapshot": {
      "types": "./dist/teamSnapshot.d.mts",
      "import": "./dist/teamSnapshot.mjs",
      "require": "./dist/teamSnapshot.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.mcp.config.ts",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "test-system": "vitest run --config vitest.system.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-cache": "workspace:*",
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-session": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "typebox": "1.3.34",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ]
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "subagents",
    "channels": [
      "subagent_catalog",
      "subagent_runs"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
