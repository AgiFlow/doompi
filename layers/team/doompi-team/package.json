{
  "name": "@agimon-ai/doompi-team",
  "version": "0.0.1-alpha.72",
  "description": "Asynchronous named subagents, team runs, intercom, and model policy for Pi coding agents.",
  "keywords": [
    "agent-team",
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "inter-agent-communication",
    "multi-agent",
    "pi-coding-agent",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "layers/team/doompi-team"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api-contracts": {
      "types": "./dist/api-contracts.d.mts",
      "import": "./dist/api-contracts.mjs",
      "require": "./dist/api-contracts.cjs"
    },
    "./capability-ceiling": {
      "types": "./dist/capability-ceiling.d.mts",
      "import": "./dist/capability-ceiling.mjs",
      "require": "./dist/capability-ceiling.cjs"
    },
    "./delegation": {
      "types": "./dist/delegation.d.mts",
      "import": "./dist/delegation.mjs",
      "require": "./dist/delegation.cjs"
    },
    "./delegation-api": {
      "types": "./dist/delegation-api.d.mts",
      "import": "./dist/delegation-api.mjs",
      "require": "./dist/delegation-api.cjs"
    },
    "./env": {
      "types": "./dist/env.d.mts",
      "import": "./dist/env.mjs",
      "require": "./dist/env.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./fable-plan": {
      "types": "./dist/fable-plan.d.mts",
      "import": "./dist/fable-plan.mjs",
      "require": "./dist/fable-plan.cjs"
    },
    "./fable-plan-api": {
      "types": "./dist/fable-plan-api.d.mts",
      "import": "./dist/fable-plan-api.mjs",
      "require": "./dist/fable-plan-api.cjs"
    },
    "./runs/background/cliRunnerEntry": {
      "types": "./dist/runs/background/cliRunnerEntry.d.mts",
      "import": "./dist/runs/background/cliRunnerEntry.mjs",
      "require": "./dist/runs/background/cliRunnerEntry.cjs"
    },
    "./runtime-subagent-policy": {
      "types": "./dist/runtime-subagent-policy.d.mts",
      "import": "./dist/runtime-subagent-policy.mjs",
      "require": "./dist/runtime-subagent-policy.cjs"
    },
    "./runtime-subagent-tool": {
      "types": "./dist/runtime-subagent-tool.d.mts",
      "import": "./dist/runtime-subagent-tool.mjs",
      "require": "./dist/runtime-subagent-tool.cjs"
    },
    "./subagent-policy": {
      "types": "./dist/subagent-policy.d.mts",
      "import": "./dist/subagent-policy.mjs",
      "require": "./dist/subagent-policy.cjs"
    },
    "./subagent-tool": {
      "types": "./dist/subagent-tool.d.mts",
      "import": "./dist/subagent-tool.mjs",
      "require": "./dist/subagent-tool.cjs"
    },
    "./team-snapshot": {
      "types": "./dist/team-snapshot.d.mts",
      "import": "./dist/team-snapshot.mjs",
      "require": "./dist/team-snapshot.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "test-system": "vitest run --config vitest.system.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-cache": "workspace:*",
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "typebox": "1.3.30",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "subagents",
    "channels": [
      "subagent_catalog",
      "subagent_runs"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
