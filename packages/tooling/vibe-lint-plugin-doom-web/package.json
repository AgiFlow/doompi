{
  "name": "@agimon-ai/vibe-lint-plugin-doom-web",
  "version": "0.0.1-alpha.44",
  "description": "Deterministic Vibe-Lint rules for DoomPi web packages",
  "keywords": [
    "doompi",
    "lint",
    "typescript",
    "vibe-lint",
    "web"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/tooling/vibe-lint-plugin-doom-web"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@agimon-ai/vibe-lint": "0.0.1-alpha.29",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "0.22.14",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@agimon-ai/vibe-lint": "0.0.1-alpha.29"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
