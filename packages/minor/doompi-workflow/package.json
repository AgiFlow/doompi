{
  "name": "@agimon-ai/doompi-workflow",
  "version": "0.0.1-alpha.37",
  "description": "GitHub Actions-style workflow graphs, artifacts, recovery, and asynchronous runs for DoomPi.",
  "keywords": [
    "ai",
    "automation",
    "coding-agent",
    "developer-tools",
    "doompi",
    "github-actions",
    "pi-extension",
    "pi-package",
    "workflow",
    "workflow-orchestration"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-workflow"
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "src/prompts",
    "skills/workflow-recovery/SKILL.md",
    "web",
    "src/types/webWorkflows.ts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./web-hub": {
      "types": "./dist/webHub.d.mts",
      "import": "./dist/webHub.mjs",
      "require": "./dist/webHub.cjs"
    },
    "./package.json": "./package.json",
    "./skills/workflow-recovery/SKILL.md": "./skills/workflow-recovery/SKILL.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@agimon-ai/workflow-mcp": "0.23.16",
    "@deepseek-ai/cordis": "4.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "react": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiWeb": {
    "pluginId": "workflows",
    "channels": [
      "workflow_runs"
    ],
    "client": "./web/index.ts",
    "hub": {
      "entry": "./src/exports/webHub.ts",
      "dist": "./dist/webHub.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
