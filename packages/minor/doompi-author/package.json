{
  "name": "@agimon-ai/doompi-author",
  "version": "0.0.1-alpha.17",
  "description": "Visual steering workspace for focused document review and bounded authoring",
  "keywords": [
    "ai",
    "authoring",
    "coding-agent",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "typescript"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-author"
  },
  "files": [
    "dist",
    "src/types/author.ts",
    "src/types/authorPreview.ts",
    "src/types/webAuthor.ts",
    "src/types/structuredDocuments.ts",
    "src/prompts",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./author-facade": {
      "types": "./dist/authorFacade.d.mts",
      "import": "./dist/authorFacade.mjs",
      "require": "./dist/authorFacade.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-minor-mode": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "csv-parse": "7.0.2",
    "hono": "4.13.7",
    "saxes": "6.0.0",
    "typebox": "1.3.30",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@agimon-ai/vibe-lint-plugin-doom-extension": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "author",
    "channels": [
      "author_webmcp"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
