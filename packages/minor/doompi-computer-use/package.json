{
  "name": "@agimon-ai/doompi-computer-use",
  "version": "0.0.1-alpha.33",
  "description": "Session scoped semantic computer control through the DoomPi Desktop capability.",
  "keywords": [
    "ai",
    "coding-agent",
    "computer-use",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "typescript"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-computer-use"
  },
  "files": [
    "dist",
    "docs",
    "src/types/computerUse.ts",
    "src/types/computerUseApi.ts",
    "src/prompts",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.mcp.config.ts",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mcp.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-minor-mode": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "quickjs-emscripten": "0.32.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@agimon-ai/vibe-lint-plugin-doom-extension": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ],
    "ui": {
      "entry": "./generated/mcp-ui.ts",
      "dist": "./dist/extensions/mcp-ui.mjs",
      "widgets": [
        "@agimon-ai/doompi-computer-use/computer_action",
        "@agimon-ai/doompi-computer-use/computer_exec",
        "@agimon-ai/doompi-computer-use/computer_state"
      ]
    }
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "computer-use",
    "channels": [
      "computer_use"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
