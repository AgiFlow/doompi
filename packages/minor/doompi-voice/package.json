{
  "name": "@agimon-ai/doompi-voice",
  "version": "0.0.1-alpha.81",
  "description": "Client audio capture, host transcription, and autonomous narration for Pi agents.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "macos",
    "pi-extension",
    "pi-package",
    "speech-to-text",
    "text-to-speech",
    "voice"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-voice"
  },
  "files": [
    "dist",
    "llms.txt",
    "src/prompts",
    "src/types/clientMedia.ts",
    "src/types/voiceOwnership.ts",
    "src/types/clientCaptureActivity.ts",
    "src/types/manualTranscription.ts",
    "src/types/realtime.ts",
    "src/extensions/workspaces/sessions/(frontend)/lifecycle/_lib/models/SILERO-LICENSE",
    "src/extensions/workspaces/sessions/(frontend)/lifecycle/_lib/models/README.md",
    "licenses",
    "NOTICE",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./clientMedia": {
      "types": "./dist/clientMedia.d.mts",
      "import": "./dist/clientMedia.mjs",
      "require": "./dist/clientMedia.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./voiceReloadHandoff": {
      "types": "./dist/voiceReloadHandoff.d.mts",
      "import": "./dist/voiceReloadHandoff.mjs",
      "require": "./dist/voiceReloadHandoff.cjs"
    },
    "./voiceTools": {
      "types": "./dist/voiceTools.d.mts",
      "import": "./dist/voiceTools.mjs",
      "require": "./dist/voiceTools.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-minor-mode": "workspace:*",
    "@agimon-ai/doompi-session": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "onnxruntime-web": "1.30.0",
    "sherpa-onnx-node": "1.13.8",
    "typebox": "1.3.34",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "voice",
    "channels": [
      "voice_media_wake",
      "voice_ownership"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
