{
  "name": "@agimon-ai/doompi-voice",
  "version": "0.0.1-alpha.42",
  "description": "Client audio capture, host transcription, and autonomous narration for Pi agents.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "macos",
    "pi-extension",
    "pi-package",
    "speech-to-text",
    "text-to-speech",
    "voice"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-voice"
  },
  "files": [
    "dist",
    "web",
    "models",
    "llms.txt",
    "src/prompts",
    "src/types/clientMedia.ts",
    "src/types/voiceOwnership.ts",
    "src/types/clientCaptureActivity.ts",
    "src/types/manualTranscription.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./client-media": {
      "types": "./dist/clientMedia.d.mts",
      "import": "./dist/clientMedia.mjs",
      "require": "./dist/clientMedia.cjs"
    },
    "./session-api": {
      "types": "./dist/sessionApi.d.mts",
      "import": "./dist/sessionApi.mjs",
      "require": "./dist/sessionApi.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "onnxruntime-web": "1.23.2",
    "sherpa-onnx-node": "1.13.6",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "react": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiApi": {
    "basePath": "voice-media",
    "session": {
      "entry": "./src/exports/sessionApi.ts",
      "dist": "./dist/sessionApi.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "voice",
    "channels": [
      "voice_media_wake",
      "voice_ownership"
    ],
    "client": "./web/index.ts",
    "hub": {
      "entry": "./src/exports/webHub.ts",
      "dist": "./dist/webHub.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
