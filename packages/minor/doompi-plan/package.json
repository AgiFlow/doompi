{
  "name": "@agimon-ai/doompi-plan",
  "version": "0.0.1-alpha.79",
  "description": "Reviewable Pi planning mode that removes file-editing tools and persists implementation plans.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "implementation-planning",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "plan-mode",
    "tool-restrictions"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-plan"
  },
  "files": [
    "dist",
    "llms.txt",
    "src/prompts",
    "src/types/planApi.ts",
    "src/types/planSettings.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./fable-flow": {
      "types": "./dist/fable-flow.d.mts",
      "import": "./dist/fable-flow.mjs",
      "require": "./dist/fable-flow.cjs"
    },
    "./log-sink-telemetry": {
      "types": "./dist/log-sink-telemetry.d.mts",
      "import": "./dist/log-sink-telemetry.mjs",
      "require": "./dist/log-sink-telemetry.cjs"
    },
    "./plan-config": {
      "types": "./dist/plan-config.d.mts",
      "import": "./dist/plan-config.mjs",
      "require": "./dist/plan-config.cjs"
    },
    "./plan-mode": {
      "types": "./dist/plan-mode.d.mts",
      "import": "./dist/plan-mode.mjs",
      "require": "./dist/plan-mode.cjs"
    },
    "./prompts": {
      "types": "./dist/prompts.d.mts",
      "import": "./dist/prompts.mjs",
      "require": "./dist/prompts.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.mcp.config.ts",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-minor-mode": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "hono": "4.13.8",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ]
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "plan",
    "channels": [],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
