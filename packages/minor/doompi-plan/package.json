{
  "name": "@agimon-ai/doompi-plan",
  "version": "0.0.1-alpha.55",
  "description": "Reviewable Pi planning mode that removes file-editing tools and persists implementation plans.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "implementation-planning",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "plan-mode",
    "tool-restrictions"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-plan"
  },
  "files": [
    "dist",
    "src/web",
    "src/exports/webClient.ts",
    "llms.txt",
    "src/prompts",
    "src/types/planApi.ts",
    "src/types/planSettings.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./fableFlow": {
      "types": "./dist/fableFlow.d.mts",
      "import": "./dist/fableFlow.mjs",
      "require": "./dist/fableFlow.cjs"
    },
    "./logSinkTelemetry": {
      "types": "./dist/logSinkTelemetry.d.mts",
      "import": "./dist/logSinkTelemetry.mjs",
      "require": "./dist/logSinkTelemetry.cjs"
    },
    "./planConfig": {
      "types": "./dist/planConfig.d.mts",
      "import": "./dist/planConfig.mjs",
      "require": "./dist/planConfig.cjs"
    },
    "./planMode": {
      "types": "./dist/planMode.d.mts",
      "import": "./dist/planMode.mjs",
      "require": "./dist/planMode.cjs"
    },
    "./prompts": {
      "types": "./dist/prompts.d.mts",
      "import": "./dist/prompts.mjs",
      "require": "./dist/prompts.cjs"
    },
    "./session-api": {
      "types": "./dist/sessionApi.d.mts",
      "import": "./dist/sessionApi.mjs",
      "require": "./dist/sessionApi.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiApi": {
    "basePath": "plans",
    "session": {
      "entry": "./src/exports/sessionApi.ts",
      "dist": "./dist/sessionApi.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "plan",
    "channels": [],
    "client": "./src/exports/webClient.ts"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
