{
  "name": "@agimon-ai/doompi-plan",
  "version": "0.0.1-alpha.37",
  "description": "Reviewable Pi planning mode that removes file-editing tools and persists implementation plans.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "implementation-planning",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "plan-mode",
    "tool-restrictions"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/minor/doompi-plan"
  },
  "files": [
    "dist",
    "llms.txt",
    "src/prompts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./fableFlow": {
      "types": "./dist/fableFlow.d.mts",
      "import": "./dist/fableFlow.mjs",
      "require": "./dist/fableFlow.cjs"
    },
    "./logSinkTelemetry": {
      "types": "./dist/logSinkTelemetry.d.mts",
      "import": "./dist/logSinkTelemetry.mjs",
      "require": "./dist/logSinkTelemetry.cjs"
    },
    "./planConfig": {
      "types": "./dist/planConfig.d.mts",
      "import": "./dist/planConfig.mjs",
      "require": "./dist/planConfig.cjs"
    },
    "./planMode": {
      "types": "./dist/planMode.d.mts",
      "import": "./dist/planMode.mjs",
      "require": "./dist/planMode.cjs"
    },
    "./prompts": {
      "types": "./dist/prompts.d.mts",
      "import": "./dist/prompts.mjs",
      "require": "./dist/prompts.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
