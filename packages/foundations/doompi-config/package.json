{
  "name": "@agimon-ai/doompi-config",
  "version": "0.0.1-alpha.90",
  "description": "Typed configuration loading, validation, and host services for composing DoomPi sessions.",
  "keywords": [
    "agent-configuration",
    "ai",
    "coding-agent",
    "configuration",
    "dependency-injection",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-package",
    "typescript",
    "yaml"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/foundations/doompi-config"
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "src/prompts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./agentPluginMcp": {
      "types": "./dist/agentPluginMcp.d.mts",
      "import": "./dist/agentPluginMcp.mjs",
      "require": "./dist/agentPluginMcp.cjs"
    },
    "./apiContracts": {
      "types": "./dist/apiContracts.d.mts",
      "import": "./dist/apiContracts.mjs",
      "require": "./dist/apiContracts.cjs"
    },
    "./atomicJson": {
      "types": "./dist/atomicJson.d.mts",
      "import": "./dist/atomicJson.mjs",
      "require": "./dist/atomicJson.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./configSchema": {
      "types": "./dist/configSchema.d.mts",
      "import": "./dist/configSchema.mjs",
      "require": "./dist/configSchema.cjs"
    },
    "./configWriter": {
      "types": "./dist/configWriter.d.mts",
      "import": "./dist/configWriter.mjs",
      "require": "./dist/configWriter.cjs"
    },
    "./domains": {
      "types": "./dist/domains.d.mts",
      "import": "./dist/domains.mjs",
      "require": "./dist/domains.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./harnessState": {
      "types": "./dist/harnessState.d.mts",
      "import": "./dist/harnessState.mjs",
      "require": "./dist/harnessState.cjs"
    },
    "./harnessStore": {
      "types": "./dist/harnessStore.d.mts",
      "import": "./dist/harnessStore.mjs",
      "require": "./dist/harnessStore.cjs"
    },
    "./init": {
      "types": "./dist/init.d.mts",
      "import": "./dist/init.mjs",
      "require": "./dist/init.cjs"
    },
    "./layeredConfig": {
      "types": "./dist/layeredConfig.d.mts",
      "import": "./dist/layeredConfig.mjs",
      "require": "./dist/layeredConfig.cjs"
    },
    "./majorModes": {
      "types": "./dist/majorModes.d.mts",
      "import": "./dist/majorModes.mjs",
      "require": "./dist/majorModes.cjs"
    },
    "./piConfig": {
      "types": "./dist/piConfig.d.mts",
      "import": "./dist/piConfig.mjs",
      "require": "./dist/piConfig.cjs"
    },
    "./piContext": {
      "types": "./dist/piContext.d.mts",
      "import": "./dist/piContext.mjs",
      "require": "./dist/piContext.cjs"
    },
    "./profiles": {
      "types": "./dist/profiles.d.mts",
      "import": "./dist/profiles.mjs",
      "require": "./dist/profiles.cjs"
    },
    "./selectionSwitch": {
      "types": "./dist/selectionSwitch.d.mts",
      "import": "./dist/selectionSwitch.mjs",
      "require": "./dist/selectionSwitch.cjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && pnpm build:mcp",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.mcp.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "typebox": "1.3.34",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/ext-apps": "1.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ],
    "ui": {
      "entry": "./generated/mcp-ui.ts",
      "dist": "./dist/extensions/mcp-ui.mjs",
      "widgets": [
        "@agimon-ai/doompi-config/load_context",
        "@agimon-ai/doompi-config/rename_thread",
        "@agimon-ai/doompi-config/show_session"
      ]
    }
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
