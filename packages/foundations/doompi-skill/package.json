{
  "name": "@agimon-ai/doompi-skill",
  "version": "0.0.1-alpha.57",
  "description": "Session skill catalogue, deferred skill discovery, and the skill browser for DoomPi.",
  "keywords": [
    "agent-skills",
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "skill-catalog",
    "skill-discovery"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/foundations/doompi-skill"
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "src/prompts",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api-contracts": {
      "types": "./dist/api-contracts.d.mts",
      "import": "./dist/api-contracts.mjs",
      "require": "./dist/api-contracts.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.mts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm build:mcp",
    "build:mcp": "tsdown --config tsdown.mcp.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-domain": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "gpt-tokenizer": "4.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@agimon-ai/vibe-lint-plugin-doom-extension": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ]
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
