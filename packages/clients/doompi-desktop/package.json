{
  "name": "@agimon-ai/doompi-desktop",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Standalone DoomPi desktop app: bundles the cockpit and the session server so a download runs an agent with no Node toolchain installed",
  "keywords": [
    "coding-agent",
    "desktop",
    "doompi",
    "electron",
    "pi-coding-agent"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/clients/doompi-desktop"
  },
  "type": "module",
  "main": "./dist/bin/main.cjs",
  "scripts": {
    "build": "pnpm run build:native && tsdown",
    "build:native": "node scripts/buildMacComputerUseHelper.mjs",
    "build:runtime": "vite build --config vite.runtime.config.ts && node scripts/downloadCloudflared.mjs",
    "package": "node scripts/assertDesktopTarget.mjs && pnpm run build && pnpm run build:runtime && node scripts/packageElectron.mjs",
    "start": "pnpm run build && pnpm run build:runtime && electron dist/bin/main.cjs",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*"
  },
  "devDependencies": {
    "@agimon-ai/doompi": "workspace:*",
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-web": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "electron": "44.3.0",
    "npm": "12.0.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
