{
  "name": "@agimon-ai/doompi-desktop",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/clients/doompi-desktop/src",
  "projectType": "application",
  "tags": ["stage:active"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/clients/doompi-desktop",
        "forwardAllArgs": false
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "cache": false,
      "options": {
        "command": "pnpm run package",
        "cwd": "packages/clients/doompi-desktop",
        "forwardAllArgs": false
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "pnpm run test:e2e",
        "cwd": "packages/clients/doompi-desktop",
        "forwardAllArgs": false
      }
    }
  }
}
