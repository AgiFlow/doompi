<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Chromium and the V8 the agent runs on both need writable-executable
	     memory under the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- The cockpit spawns this same binary as Node by setting
	     ELECTRON_RUN_AS_NODE, which the hardened runtime otherwise strips. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- Native addons in the staged payload are signed by our own identity
	     rather than Apple's, and esbuild is a separate executable. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
