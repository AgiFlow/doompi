{
  "name": "@agimon-ai/doompi-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/clients/doompi-web/src",
  "projectType": "application",
  "tags": ["stage:active"],
  "sourceTemplate": "doom-web",
  "targets": {
    "test": {
      "dependsOn": [
        "build",
        "^build",
        {
          "projects": [
            "@agimon-ai/doompi-workflow",
            "@agimon-ai/doompi-plan",
            "@agimon-ai/doompi-team",
            "@agimon-ai/doompi-voice"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/minor/doompi-workflow/**/*",
        "{workspaceRoot}/packages/minor/doompi-plan/**/*",
        "{workspaceRoot}/layers/team/doompi-team/**/*",
        "{workspaceRoot}/packages/minor/doompi-voice/**/*"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{projectRoot}/package.json"],
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/clients/doompi-web",
        "forwardAllArgs": false
      }
    }
  }
}
