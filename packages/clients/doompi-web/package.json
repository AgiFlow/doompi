{
  "name": "@agimon-ai/doompi-web",
  "version": "0.0.1-alpha.16",
  "description": "Web cockpit for DoomPi: serves a browser session console and bridges it to an authenticated doompi-server socket",
  "keywords": [
    "cockpit",
    "coding-agent",
    "doompi",
    "pi-coding-agent",
    "session-console",
    "web"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/clients/doompi-web"
  },
  "bin": {
    "doompi-web": "./dist/bin/serve.mjs"
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./bundler": {
      "types": "./dist/bundler.d.mts",
      "import": "./dist/bundler.mjs",
      "require": "./dist/bundler.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && vite build --config vite.pwa.config.ts && vite build --config vite.pwa.config.ts --mode worker",
    "dev": "vite",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi": "workspace:*",
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-server": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@earendil-works/chord": "0.85.0",
    "@earendil-works/pi-client": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-protocol": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@hono/node-server": "2.1.1",
    "@hono/node-ws": "1.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@vitejs/plugin-react": "6.1.1",
    "@zxing/browser": "^0.2.1",
    "hono": "4.13.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@agimon-ai/vibe-lint-plugin-doom-web": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiWeb": []
}
