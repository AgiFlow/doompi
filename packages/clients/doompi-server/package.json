{
  "name": "@agimon-ai/doompi-server",
  "version": "0.0.1-alpha.0",
  "description": "Headless DoomPi session server: supervises a Pi RPC agent behind an authenticated unix socket so clients can attach and reattach",
  "keywords": [
    "agent-server",
    "coding-agent",
    "doompi",
    "headless",
    "pi-coding-agent",
    "rpc",
    "session-server"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/clients/doompi-server"
  },
  "bin": {
    "doompi-server": "./dist/bin/serve.mjs"
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi": "workspace:*",
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@earendil-works/pi-protocol": "0.84.3",
    "@earendil-works/pi-server": "0.84.3",
    "@hono/node-server": "2.1.1"
  },
  "devDependencies": {
    "@agimon-ai/vibe-lint-plugin-doom-extension": "workspace:*",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
