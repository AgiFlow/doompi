      "require": "./dist/uiState.cjs"
    },
    "./package.json": "./package.json",
    "./themes/doom-pi-dark.json": "./themes/doom-pi-dark.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-extension-contracts": "workspace:*",
    "@agimon-ai/doompi-hashline": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "react": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiWeb": {
    "pluginId": "builtin-tools",
    "channels": [],
    "client": "./web/index.ts"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
