{
  "name": "@agimon-ai/doompi-ui",
  "version": "0.0.1-alpha.43",
  "description": "Leader-key menus, themes, and TUI components for DoomPi and Pi extensions.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "leader-key",
    "pi-extension",
    "pi-package",
    "pi-tui",
    "terminal-ui",
    "tui"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/core/doompi-ui"
  },
  "files": [
    "dist",
    "web",
    "themes"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components/configOverlay": {
      "types": "./dist/components/configOverlay.d.mts",
      "import": "./dist/components/configOverlay.mjs",
      "require": "./dist/components/configOverlay.cjs"
    },
    "./components/doomEditor": {
      "types": "./dist/components/doomEditor.d.mts",
      "import": "./dist/components/doomEditor.mjs",
      "require": "./dist/components/doomEditor.cjs"
    },
    "./components/doomFooter": {
      "types": "./dist/components/doomFooter.d.mts",
      "import": "./dist/components/doomFooter.mjs",
      "require": "./dist/components/doomFooter.cjs"
    },
    "./components/doomHeader": {
      "types": "./dist/components/doomHeader.d.mts",
      "import": "./dist/components/doomHeader.mjs",
      "require": "./dist/components/doomHeader.cjs"
    },
    "./components/doomOverlay": {
      "types": "./dist/components/doomOverlay.d.mts",
      "import": "./dist/components/doomOverlay.mjs",
      "require": "./dist/components/doomOverlay.cjs"
    },
    "./components/leaderHints": {
      "types": "./dist/components/leaderHints.d.mts",
      "import": "./dist/components/leaderHints.mjs",
      "require": "./dist/components/leaderHints.cjs"
    },
    "./components/matrixPicker": {
      "types": "./dist/components/matrixPicker.d.mts",
