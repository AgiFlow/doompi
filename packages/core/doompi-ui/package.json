      "require": "./dist/components/matrixPicker.cjs"
    },
    "./components/toolsOverlay": {
      "types": "./dist/components/toolsOverlay.d.mts",
      "import": "./dist/components/toolsOverlay.mjs",
      "require": "./dist/components/toolsOverlay.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./extension": {
      "types": "./dist/extension.d.mts",
      "import": "./dist/extension.mjs",
      "require": "./dist/extension.cjs"
