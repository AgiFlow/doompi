{
  "name": "@agimon-ai/doompi-minor-mode",
  "version": "0.0.1-alpha.69",
  "description": "Minor-mode ownership, catalog, commands, and session lifecycle.",
  "keywords": [
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "layer-composition",
    "major-mode",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session-reload"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/core/doompi-minor-mode"
  },
  "files": [
    "dist",
    "llms.txt",
    "src/prompts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./command": {
      "types": "./dist/command.d.mts",
      "import": "./dist/command.mjs",
      "require": "./dist/command.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.mts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.cjs"
    },
    "./projection": {
      "types": "./dist/projection.d.mts",
      "import": "./dist/projection.mjs",
      "require": "./dist/projection.cjs"
    },
    "./reload-handoff": {
      "types": "./dist/reload-handoff.d.mts",
      "import": "./dist/reload-handoff.mjs",
      "require": "./dist/reload-handoff.cjs"
    },
    "./minor-mode-command": {
      "types": "./dist/minor-mode-command.d.mts",
      "import": "./dist/minor-mode-command.mjs",
      "require": "./dist/minor-mode-command.cjs"
    },
    "./mode": {
      "types": "./dist/mode.d.mts",
      "import": "./dist/mode.mjs",
      "require": "./dist/mode.cjs"
    },
    "./mode-definition": {
      "types": "./dist/mode-definition.d.mts",
      "import": "./dist/mode-definition.mjs",
      "require": "./dist/mode-definition.cjs"
    },
    "./owner": {
      "types": "./dist/owner.d.mts",
      "import": "./dist/owner.mjs",
      "require": "./dist/owner.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./package.json": "./package.json",
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "typebox": "1.3.25"
  },
  "devDependencies": {
    "@agimon-ai/vibe-lint-plugin-doom-extension": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./src/extensions/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "session"
    ],
    "required": true,
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
