{
  "name": "@agimon-ai/doompi-log",
  "version": "0.0.1-alpha.92",
  "description": "Pi session metrics, findings, sink status, and a Log Metrics overlay for agent observability.",
  "keywords": [
    "agent-observability",
    "ai",
    "coding-agent",
    "developer-tools",
    "doompi",
    "log-sink",
    "logging",
    "metrics",
    "pi-extension",
    "pi-package",
    "telemetry"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/default/doompi-log"
  },
  "files": [
    "dist",
    "llms.txt",
    "src/prompts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./apiContracts": {
      "types": "./dist/apiContracts.d.mts",
      "import": "./dist/apiContracts.mjs",
      "require": "./dist/apiContracts.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./metrics": {
      "types": "./dist/metrics.d.mts",
      "import": "./dist/metrics.mjs",
      "require": "./dist/metrics.cjs"
    },
    "./metricsOverlay": {
      "types": "./dist/metricsOverlay.d.mts",
      "import": "./dist/metricsOverlay.mjs",
      "require": "./dist/metricsOverlay.cjs"
    },
    "./metricsSource": {
      "types": "./dist/metricsSource.d.mts",
      "import": "./dist/metricsSource.mjs",
      "require": "./dist/metricsSource.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@agimon-ai/doompi-web-components": "workspace:*",
    "@agimon-ai/doompi-web-security": "workspace:*",
    "@agimon-ai/log-sink-mcp": "0.29.30",
    "@deepseek-ai/cordis": "4.0.2",
    "hono": "4.13.8",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@agimon-ai/doompi-ui": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/apiContracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "log",
    "channels": [],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "global",
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
