{
  "name": "@agimon-ai/doompi-runner",
  "version": "0.0.1-alpha.82",
  "description": "Supervised shell execution, background process control, and run logs for Pi coding agents.",
  "keywords": [
    "ai",
    "background-process",
    "coding-agent",
    "developer-tools",
    "doom-runner",
    "doompi",
    "pi-coding-agent",
    "pi-package",
    "process-supervision",
    "shell"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/default/doompi-runner"
  },
  "bin": {
    "doompi-runner": "./dist/bin/cli.mjs"
  },
  "files": [
