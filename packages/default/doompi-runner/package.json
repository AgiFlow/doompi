    "@agimon-ai/doompi-runner-rtk-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiMcp": {
    "entry": "./generated/mcp.ts",
    "dist": "./dist/extensions/mcp.mjs",
    "scopes": [
      "session"
    ]
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "global",
      "workspace",
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "runner",
    "channels": [
      "runner_runs"
    ],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "session"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
