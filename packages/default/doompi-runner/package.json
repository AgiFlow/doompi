    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@agimon-ai/doompi-runner-rmux-darwin-arm64": "workspace:*",
    "@agimon-ai/doompi-runner-rmux-darwin-x64": "workspace:*",
    "@agimon-ai/doompi-runner-rmux-linux-arm64": "workspace:*",
    "@agimon-ai/doompi-runner-rmux-linux-x64": "workspace:*",
    "@agimon-ai/doompi-runner-rtk-darwin-arm64": "workspace:*",
