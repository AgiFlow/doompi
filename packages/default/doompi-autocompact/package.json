{
  "name": "@agimon-ai/doompi-autocompact",
  "version": "0.0.1-alpha.76",
  "description": "Iterative context compaction and checkpoint summaries for Pi and DoomPi agent sessions.",
  "keywords": [
    "ai",
    "coding-agent",
    "context-compaction",
    "context-window",
    "developer-tools",
    "doompi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "summarization"
  ],
  "homepage": "https://agimon.ai",
  "bugs": {
    "url": "https://github.com/AgiFlow/doompi/issues"
  },
  "license": "MIT",
  "author": "Vuong Ngo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgiFlow/doompi.git",
    "directory": "packages/default/doompi-autocompact"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "jsnext:main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api-contracts": {
      "types": "./dist/api-contracts.d.mts",
      "import": "./dist/api-contracts.mjs",
      "require": "./dist/api-contracts.cjs"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi.d.mts",
      "import": "./dist/extensions/pi.mjs",
      "require": "./dist/extensions/pi.cjs"
    },
    "./extensions/server": {
      "types": "./dist/extensions/server.d.mts",
      "import": "./dist/extensions/server.mjs",
      "require": "./dist/extensions/server.cjs"
    },
    "./extensions/web": {
      "import": "./dist/extensions/web.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . && oxfmt . --check",
    "fixcode": "oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@agimon-ai/doompi-config": "workspace:*",
    "@agimon-ai/doompi-core": "workspace:*",
    "@agimon-ai/doompi-telemetry": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@agimon-ai/doompi-build": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "doompiServer": {
    "entry": "./generated/server.ts",
    "dist": "./dist/extensions/server.mjs",
    "scopes": [
      "session"
    ],
    "contracts": {
      "entry": "./src/exports/apiContracts.ts",
      "dist": "./dist/api-contracts.mjs"
    }
  },
  "doompiWeb": {
    "pluginId": "autocompact",
    "channels": [],
    "client": "./dist/extensions/web.mjs",
    "scopes": [
      "global",
      "workspace"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi.mjs"
    ]
  }
}
